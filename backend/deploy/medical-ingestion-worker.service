[Unit]
Description=Medical document ingestion worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/medical-agentic-chatbot/backend
EnvironmentFile=/etc/medical-agentic-chatbot/worker.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/medical-agentic-chatbot/backend/.venv/bin/python -m worker
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0077

[Install]
WantedBy=multi-user.target
